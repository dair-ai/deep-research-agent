# Anthropic
ANTHROPIC_API_KEY=your-api-key

# Exa (for web search - get key at https://exa.ai/)
EXA_API_KEY=your-exa-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Sandbox (required for production deployment)
# Get your API token from: https://vercel.com/account/tokens
# The sandbox runs the research agent in an isolated container
VERCEL_API_TOKEN=your-vercel-api-token
# Project ID and Team ID (find in Vercel dashboard project settings)
VERCEL_PROJECT_ID=your-project-id
VERCEL_TEAM_ID=your-team-id
